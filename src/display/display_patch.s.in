// CoreDisplay mode check using conditional branches. Stack operands are
// filled from the instruction block matched on the running system.
// IOGraphics mode flags: television bit 20, native bit 25, valid bit 0,
// safe bit 1, mirroring bit 21, and AirPlay bit 24.
.set kTelevisionBit, 20
.set kNativeBit, 25
.set kValidFlag, 1
.set kSafeFlag, 2
.set kMirroringOrAirPlayFlags, 0x01200000

// Keep encoded displacement widths fixed when stack offsets change.
.text
.globl _duolink_display_exception
_duolink_display_exception:
    movl 144(%rbx), %ecx
    {disp32} movq @mode@(%rbp), %rsi
    movl 20(%rsi), %eax
    // Preserve Apple's television-mode exemption.
    btl $kTelevisionBit, %ecx
    jc L_flags_validity
    // Keep CoreDisplay's pixel-format requirement before testing dimensions.
    {disp32} cmpl $4, @format_check@(%rbp)
    jb L_too_small
    // Add only physical 1920x515 modes carrying the native driver flag.
    cmpl $1920, @width@(%rbp)
    jne L_ordinary_size
    cmpl $515, @height@(%rbp)
    jne L_ordinary_size
    btl $kNativeBit, %eax
    jc L_flags_validity
L_ordinary_size:
    // Keep the original signed width >= 800 and height >= 600 rule.
    cmpl $800, @width@(%rbp)
    jl L_too_small
    cmpl $600, @height@(%rbp)
    jge L_flags_validity
L_too_small:
    // Keep Apple's size-failure result, including the copied safe flag.
    andl $0xbffffffc, %r15d
    movl %eax, %edx
    andl $kSafeFlag, %edx
    shll $28, %edx
    orl %edx, %r15d
    btsl $30, %r15d
L_flags_validity:
    // For a mode lacking the valid flag, preserve bit 30 when it is safe
    // for mirroring or AirPlay; otherwise set bit 31. This shorter encoding
    // leaves room for the native-size exception without growing the block.
    testb $kValidFlag, %al
    jnz L_done
    andl $0x1ffffffc, %r15d
    testb $kSafeFlag, %al
    jz L_unusable
    testl $kMirroringOrAirPlayFlags, %eax
    jnz L_preserved_safe
L_unusable:
    btsl $31, %r15d
    jmp L_done
L_preserved_safe:
    btsl $30, %r15d
L_done:
.fill @size@ - (. - _duolink_display_exception), 1, 0x90
