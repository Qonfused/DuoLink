.set kMinimumWidth, 800
.set kMinimumHeight, 600
.set kScreenPadWidth, 1920
.set kScreenPadHeight, 515
.set kTelevisionBit, 20
.set kNativeBit, 25

// Subtracting 600 tests the desktop height minimum and leaves -85 for a
// 515-line ScreenPad, so the second comparison needs only a one-byte immediate.
.macro check_geometry width, height, flags
    cmpl $kMinimumWidth, \width
    jl L_size_failure
    subl $kMinimumHeight, \height
    jge L_driver_validity
    cmpl $(kScreenPadHeight-kMinimumHeight), \height
    jne L_size_failure
    cmpl $kScreenPadWidth, \width
    jne L_size_failure
    btl $kNativeBit, \flags
    jc L_driver_validity
.endm

// Only the low nibble survives the shift. Bits 2 and 1 become the failure
// flag (bit 30) and the driver's safe flag (bit 29) in the classification.
.macro mark_size_failure flags, scratch, scratch_byte, result, result_byte
    movl \flags, \scratch
    andb $2, \scratch_byte
    orb $4, \scratch_byte
    shll $28, \scratch
    andb $-4, \result_byte
    orl \scratch, \result
.endm

.text
_duolink_display_exception:
#if defined(BRANCH_R12) || defined(BRANCH_R13)
    // RBX points to the display record on the stack. Reading its flags via
    // RBP and the format code at RBX - 32 gives both operands short offsets.
    {disp8} movl @display_flags@(%rbp), %ecx
#if defined(BRANCH_R12)
    movl 20(%r12), %edx
#else
    movl 20(%r13), %edx
#endif
    btl $kTelevisionBit, %ecx
    jc L_driver_validity
    cmpl $4, -32(%rbx)
    jb L_size_failure
#elif defined(BRANCH)
    movl 144(%rbx), %ecx
    {disp32} movq @mode@(%rbp), %rsi
    movl 20(%rsi), %edx
    btl $kTelevisionBit, %ecx
    jc L_driver_validity
    {disp32} cmpl $4, @format_check@(%rbp)
    jb L_size_failure
#endif
#if defined(BRANCH) || defined(BRANCH_R12) || defined(BRANCH_R13)
    {disp8} movl @height@(%rbp), %eax
    check_geometry @width@(%rbp), %eax, %edx
L_size_failure:
    mark_size_failure %edx, %eax, %al, %r15d, %r15b
L_driver_validity:
    // Return the driver flags in EAX for CoreDisplay's valid-bit test.
    xchgl %eax, %edx
#elif defined(SETCC)
    {disp32} movq @mode@(%rbp), %rdx
    movl 20(%rdx), %eax
    btl $kTelevisionBit, %r14d
    jc L_driver_validity
    {disp32} testb $1, @format_check@(%rbp)
    jz L_size_failure
    // EDI can hold width because CoreDisplay reloads it after testing AL.
    {disp32} movl @width@(%rbp), %edi
    {disp32} movl @height@(%rbp), %ecx
    check_geometry %edi, %ecx, %eax
L_size_failure:
    mark_size_failure %eax, %ecx, %cl, %ebx, %bl
L_driver_validity:
#elif defined(REGISTER_FLAGS)
    // Addressing nearby locals from width saves enough instruction bytes
    // to restore RAX and ECX before CoreDisplay tests the valid bit.
    {disp32} leaq @width@(%rbp), %rcx
    btl $kTelevisionBit, %r15d
    jc L_driver_validity
    {disp8} testb $1, @format_check_delta@(%rcx)
    jz L_size_failure
    {disp8} movl @height_delta@(%rcx), %eax
    check_geometry (%rcx), %eax, %r15d
L_size_failure:
    mark_size_failure %r15d, %eax, %al, %r14d, %r14b
L_driver_validity:
    {disp8} movq @mode_delta@(%rcx), %rax
    {disp8} movl @saved_flags_delta@(%rcx), %ecx
#elif defined(FORMAT_REGISTER)
    {disp32} leaq @width@(%rbp), %rdi
    btl $kTelevisionBit, %ebx
    jc L_driver_validity
    cmpl $4, %r12d
    jb L_size_failure
    {disp8} movl @height_delta@(%rdi), %eax
    check_geometry (%rdi), %eax, %ebx
L_size_failure:
    mark_size_failure %ebx, %eax, %al, %r14d, %r14b
L_driver_validity:
    {disp8} movq @mode_delta@(%rdi), %rdi
#elif defined(PACKED)
    btl $kTelevisionBit, %r15d
    jc L_load_mode
    {disp32} movdqa @width@(%rbp), %xmm0
    pcmpgtd @thresholds@(%rip), %xmm0
    pmovsxdq %xmm0, %xmm0
    movmskps %xmm0, %eax
L_load_mode:
    // The vector instructions preserve CF, so this path can load the mode
    // pointer for every display before branching on the television bit.
    {disp32} leaq @width@(%rbp), %rcx
    {disp8} movq @mode_delta@(%rcx), %rdx
    jc L_driver_validity
    {disp8} testb $1, @format_check_delta@(%rcx)
    jz L_size_failure
    // MOVMSKPS reads two sign bits per widened lane, so 0xF means both
    // width and height passed CoreDisplay's signed comparison.
    cmpb $15, %al
    je L_driver_validity
    movabsq $((kScreenPadHeight << 32) + kScreenPadWidth), %rax
    cmpq %rax, (%rcx)
    jne L_size_failure
    btl $kNativeBit, 20(%rdx)
    jc L_driver_validity
L_size_failure:
    mark_size_failure 20(%rdx), %eax, %al, %r13d, %r13b
L_driver_validity:
    movl 20(%rdx), %eax
#else
#error Unknown CoreDisplay mode-check layout
#endif
.fill @size@ - (. - _duolink_display_exception), 1, 0x90
